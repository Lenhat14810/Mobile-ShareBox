<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/sb_card" android:clipToOutline="true">
    <FrameLayout android:id="@+id/art_frame" android:layout_width="match_parent" android:layout_height="132dp">
        <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:padding="12dp"/>
        <ImageView android:id="@+id/hot" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="top|start" android:layout_margin="4dp" android:src="@drawable/hot_art" android:contentDescription="HOT"/>
        <TextView android:id="@+id/new_tag" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NEW" android:layout_gravity="bottom|start" android:layout_margin="6dp" android:paddingHorizontal="8dp" android:paddingVertical="3dp" android:background="@drawable/sb_blue" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="12sp"/>
        <ImageButton android:id="@+id/favorite" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_gravity="top|end" android:layout_margin="4dp" android:padding="12dp"
            android:scaleType="fitCenter" android:src="@drawable/sb_ic_heart" />
    </FrameLayout>
    <LinearLayout android:id="@+id/caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
        <TextView android:id="@+id/name" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:minLines="2" android:maxLines="2" android:textStyle="bold" android:textSize="14sp"/>
        <TextView android:id="@+id/price" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textStyle="bold" android:layout_marginTop="3dp"/>
        <TextView android:id="@+id/deposit" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/sb_muted"/>
        <TextView android:id="@+id/location" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/sb_muted"/>
        <TextView android:id="@+id/quantity" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textSize="12sp" android:textColor="@color/sb_muted"/>
        <TextView android:id="@+id/chat_action" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chat với chủ đồ" android:minHeight="48dp" android:gravity="center" android:textColor="@color/sb_accent"/>
    </LinearLayout>
</LinearLayout>
