<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"><include layout="@layout/screen_frame"/><LinearLayout android:id="@+id/splash_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:padding="28dp" android:background="@drawable/sb_gradient">
            <ImageView android:id="@+id/splash_logo" android:layout_width="104dp" android:layout_height="104dp" android:padding="25dp" android:src="@drawable/ic_sharebox_mark" android:background="@drawable/sb_white" android:contentDescription="@string/app_name" />
            <TextView android:id="@+id/splash_brand" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ShareBox" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="38sp" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/splash_tag" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chia sẻ tiện ích – Kết nối cộng đồng" android:textColor="#FFFFFF" android:gravity="center"/>
            <ProgressBar android:id="@+id/splash_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="72dp" android:max="100" android:progressTint="#FFFFFF"/>
            <TextView android:id="@+id/splash_hint" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Chạm để tiếp tục" android:textColor="#FFFFFF" android:layout_marginTop="12dp"/>
         </LinearLayout></FrameLayout>
