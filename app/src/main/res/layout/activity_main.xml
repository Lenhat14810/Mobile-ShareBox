<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/sb_canvas">
    <androidx.fragment.app.FragmentContainerView android:id="@+id/nav_host" android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp" android:layout_height="0dp" app:defaultNavHost="true" app:navGraph="@navigation/sharebox_graph"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/bottom_nav"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout android:id="@+id/bottom_nav" android:layout_width="0dp" android:layout_height="60dp"
        android:background="@color/sb_paper" android:elevation="6dp" android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <TextView android:id="@+id/nav_home" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:maxLines="2" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="@string/sb_home"/><TextView android:id="@+id/nav_explore" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:maxLines="2" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="@string/sb_explore"/><Space android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/><TextView android:id="@+id/nav_chat" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:maxLines="2" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="@string/sb_chat"/><TextView android:id="@+id/nav_profile" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:maxLines="2" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:text="@string/sb_profile"/>
    </LinearLayout>
    <TextView android:id="@+id/nav_create" android:layout_width="64dp" android:layout_height="64dp"
        android:gravity="center" android:text="+" android:textColor="#FFFFFF" android:textSize="37sp" android:elevation="9dp"
        android:background="@drawable/sb_fab" android:layout_marginBottom="9dp" android:contentDescription="Đăng tin mới"
        app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <LinearLayout android:id="@+id/assistant" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:elevation="10dp" android:layout_marginStart="14dp" android:layout_marginBottom="92dp"
        app:layout_constraintStart_toStartOf="parent" app:layout_constraintBottom_toTopOf="@id/bottom_nav">
        <ImageView android:id="@+id/robot" android:layout_width="56dp" android:layout_height="56dp" android:src="@drawable/assistant_art" android:contentDescription="Mở ShareBox AI" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/suggestion" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cần thuê hay mượn đồ gì?" android:background="@drawable/sb_card" android:maxWidth="190dp" android:padding="8dp" android:textSize="12sp"/>
        <TextView android:id="@+id/assistant_close" style="@style/SbText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="×" android:gravity="center" android:minWidth="48dp" android:minHeight="48dp" android:contentDescription="Ẩn trợ lý"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
