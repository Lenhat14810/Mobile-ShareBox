<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/password_label" style="@style/SbText" android:textStyle="bold"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"
        android:background="@drawable/sb_card" android:paddingStart="14dp">
        <androidx.appcompat.widget.AppCompatEditText android:id="@+id/password_input" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="52dp"
            android:background="@android:color/transparent" android:singleLine="true" android:inputType="textPassword"
            android:fontFamily="sans" android:textColor="@color/sb_ink" android:textColorHint="@color/sb_muted"
            android:textSize="14sp" android:hint="@string/sb_password_hint"/>
        <ImageButton android:id="@+id/password_visibility" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/sb_ic_eye" app:tint="@color/sb_muted" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sb_show_password"/>
    </LinearLayout>
</LinearLayout>
